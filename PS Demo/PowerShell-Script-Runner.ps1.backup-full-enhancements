# Toast Notification Function
function Show-ToastNotification {
    param(
        [string]$title,
        [string]$message,
        [string]$status = "Info"  # "Success", "Failed", "Info"
    )
    
    # Use NotifyIcon balloon tip - works reliably on all Windows versions
    try {
        $global:notifyIcon = New-Object System.Windows.Forms.NotifyIcon
        $global:notifyIcon.Icon = [System.Drawing.SystemIcons]::Information
        $global:notifyIcon.BalloonTipTitle = $title
        $global:notifyIcon.BalloonTipText = $message
        
        $global:notifyIcon.BalloonTipIcon = switch ($status) {
            "Success" { [System.Windows.Forms.ToolTipIcon]::Info }
            "Failed" { [System.Windows.Forms.ToolTipIcon]::Error }
            "Stopped" { [System.Windows.Forms.ToolTipIcon]::Warning }
            default { [System.Windows.Forms.ToolTipIcon]::Info }
        }
        
        $global:notifyIcon.Visible = $true
        $global:notifyIcon.ShowBalloonTip(5000)
        
        # Set up timer to clean up the icon after 6 seconds
        $cleanupTimer = New-Object System.Windows.Forms.Timer
        $cleanupTimer.Interval = 6000
        $cleanupTimer.Add_Tick({
            $global:notifyIcon.Visible = $false
            $global:notifyIcon.Dispose()
            $this.Stop()
            $this.Dispose()
        })
        $cleanupTimer.Start()
    }
    catch {
        # Silently fail if notifications aren't available
        Write-TerminalOutput "Notification: $title - $message" ([System.Drawing.Color]::FromArgb(100, 149, 237))
    }
}

# Execution History Log Functions
function Add-ExecutionLogEntry {
    param(
        [string]$scriptName,
        [string]$scriptPath,
        [string]$status,  # "Success", "Failed", "Stopped"
        [int]$exitCode,
        [int]$durationSeconds,
        [bool]$showNotification = $false
    )
    
    $entry = @{
        ScriptName = $scriptName
        ScriptPath = $scriptPath
        Status = $status
        ExitCode = $exitCode
        Duration = $durationSeconds
        Timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    }
    
    # Load existing history
    $script:executionHistory = Load-ExecutionHistory
    
    # Add new entry at the beginning
    $script:executionHistory = @($entry) + $script:executionHistory | Select-Object -First 100
    
    # Save to file
    Save-ExecutionHistory
    
    # Show toast notification if requested (for scheduled tasks)
    if ($showNotification) {
        $durationText = if ($durationSeconds -gt 60) { "$([Math]::Floor($durationSeconds / 60))m $($durationSeconds % 60)s" } else { "${durationSeconds}s" }
        $notifTitle = "Script $status"
        $notifMessage = "$scriptName completed in $durationText (Exit code: $exitCode)"
        Show-ToastNotification -title $notifTitle -message $notifMessage -status $status
    }
}

