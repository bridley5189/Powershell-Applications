# ==================== OpenAI API Functions ====================

function Get-OpenAIApiKey {
    # Load API key from encrypted storage
    $apiKeyFile = Join-Path $settingsDir "openai_key.txt"
    
    if (Test-Path $apiKeyFile) {
        try {
            $encryptedKey = Get-Content $apiKeyFile
            $script:openAIApiKey = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto(
                [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR(
                    ($encryptedKey | ConvertTo-SecureString)
                )
            )
            return $true
        } catch {
            Write-Host "Failed to load API key: $($_.Exception.Message)" -ForegroundColor Red
            return $false
        }
    }
    return $false
}

function Set-OpenAIApiKey {
    param([string]$apiKey)
    
    $apiKeyFile = Join-Path $settingsDir "openai_key.txt"
    
    try {
        $secureKey = ConvertTo-SecureString $apiKey -AsPlainText -Force
        $encryptedKey = ConvertFrom-SecureString $secureKey
        Out-File -FilePath $apiKeyFile -InputObject $encryptedKey -Encoding UTF8 -Force
        $script:openAIApiKey = $apiKey
        return $true
    } catch {
        Write-Host "Failed to save API key: $($_.Exception.Message)" -ForegroundColor Red
        return $false
    }
}

function Invoke-OpenAI {
    param(
        [string]$prompt,
        [string]$systemPrompt = "You are an expert PowerShell developer assistant.",
        [string]$model = $script:aiModel
    )
    
    if ([string]::IsNullOrEmpty($script:openAIApiKey)) {
        return @{ Success = $false; Error = "API key not configured. Please set your OpenAI API key." }
    }
    
    $apiUrl = "https://api.openai.com/v1/chat/completions"
    
    $headers = @{
        "Authorization" = "Bearer $($script:openAIApiKey)"
        "Content-Type" = "application/json"
    }
    
    $body = @{
        model = $model
        messages = @(
            @{ role = "system"; content = $systemPrompt }
            @{ role = "user"; content = $prompt }
        )
        temperature = 0.7
        max_tokens = 2000
    } | ConvertTo-Json -Depth 10
    
    try {
        $response = Invoke-RestMethod -Uri $apiUrl -Method Post -Headers $headers -Body $body -TimeoutSec 30
        
        if ($response.choices -and $response.choices.Count -gt 0) {
            return @{
                Success = $true
                Content = $response.choices[0].message.content
                Model = $response.model
                Usage = $response.usage
            }
        } else {
            return @{ Success = $false; Error = "No response from AI" }
        }
    } catch {
        $errorMessage = $_.Exception.Message
        if ($_.ErrorDetails.Message) {
            $errorDetails = $_.ErrorDetails.Message | ConvertFrom-Json
            $errorMessage = $errorDetails.error.message
        }
        return @{ Success = $false; Error = $errorMessage }
    }
}

