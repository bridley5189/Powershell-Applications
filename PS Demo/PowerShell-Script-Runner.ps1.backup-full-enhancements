function Start-SchedulerTimer {
    $script:schedulerTimer = New-Object System.Windows.Forms.Timer
    $script:schedulerTimer.Interval = 30000  # Check every 30 seconds
    $script:schedulerTimer.Add_Tick({
        $tasks = Load-ScheduledTasks
        $now = [DateTime]::Now
        $updated = $false
        
        foreach ($task in $tasks) {
            if ($task.Status -eq "Pending") {
                $scheduledTime = [DateTime]::Parse($task.ScheduledTime)
                if ($now -ge $scheduledTime) {
                    # Run the scheduled task
                    Write-TerminalOutput "Running scheduled task: $($task.ScriptName)" ([System.Drawing.Color]::FromArgb(102, 16, 242))
                    
                    if (Test-Path $task.ScriptPath) {
                        # Show toast notification when scheduled task completes
                        Run-Script -scriptPath $task.ScriptPath -asAdmin $task.RunAsAdmin -showNotification $true
                    } else {
                        Write-TerminalOutput "Scheduled script not found: $($task.ScriptPath)" ([System.Drawing.Color]::FromArgb(220, 53, 69))
                        # Show error notification
                        Show-ToastNotification -title "Scheduled Task Failed" -message "Script not found: $($task.ScriptName)" -status "Failed"
                    }
                    
                    # Mark as completed
                    $task.Status = "Completed"
                    $updated = $true
                }
            }
        }
        
        if ($updated) {
            $script:scheduledTasks = $tasks
            Save-ScheduledTasks
        }
    })
    $script:schedulerTimer.Start()
}

function Load-Settings {
    if (-not (Test-Path $settingsFile)) {
        return $null
    }
    
    try {
        $settings = Get-Content -Path $settingsFile -Raw | ConvertFrom-Json
        return $settings
    } catch {
        Write-Host "Warning: Could not load settings - $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }
}

function Restore-Settings {
    param($settings)
    
    if ($null -eq $settings) {
        return
    }
    
    # Restore window size and position
    if ($settings.WindowWidth -and $settings.WindowHeight) {
        $form.Width = $settings.WindowWidth
        $form.Height = $settings.WindowHeight
    }
    
    if ($settings.WindowX -and $settings.WindowY) {
        # Only restore position if it's within reasonable bounds
        if ($settings.WindowX -ge 0 -and $settings.WindowY -ge 0 -and $settings.WindowX -lt [System.Windows.Forms.Screen]::PrimaryScreen.Bounds.Width -and $settings.WindowY -lt [System.Windows.Forms.Screen]::PrimaryScreen.Bounds.Height) {
            $form.Location = New-Object System.Drawing.Point($settings.WindowX, $settings.WindowY)
        }
    }
    
    # Restore recursive scan setting
    if ($settings.PSObject.Properties['RecursiveScan']) {
        $recursiveCheckBox.Checked = $settings.RecursiveScan
    }
    
    # Restore last folder path and scripts
    if ($settings.LastFolderPath -and (Test-Path $settings.LastFolderPath)) {
        $folderTextBox.Text = $settings.LastFolderPath
        Update-ScriptsList -folderPath $settings.LastFolderPath
    }
    
    # Restore recent scripts history
    if ($settings.RecentScripts) {
        $script:scriptHistory = @($settings.RecentScripts)
        Update-HistoryListBox
    }
}

function Write-TerminalOutput {
    param([string]$message, [object]$color = $null)
    $timestamp = Get-Date -Format "HH:mm:ss"
    
    if ($color) {
        $terminalTextBox.SelectionColor = $color
    }
    $terminalTextBox.AppendText("[$timestamp] $message`r`n")
    if ($color) {
        $terminalTextBox.SelectionColor = $terminalTextBox.ForeColor
    }
    $terminalTextBox.ScrollToCaret()
}

function Start-ScriptExecution {
    param($scriptName)
    
    $script:currentRunningScript = $scriptName
    $script:scriptStartTime = Get-Date
    $script:originalTerminalText = $terminalTextBox.Text
    $script:isScriptRunning = $true
    $script:spinnerIndex = 0
    
    # Enable stop button, disable run buttons
    $script:stopButton.Enabled = $true
    $script:runButton.Enabled = $false
    $script:runAsAdminButton.Enabled = $false
    
    # Show progress bar with marquee style
    $progressBar.Style = [System.Windows.Forms.ProgressBarStyle]::Marquee
    $progressBar.MarqueeAnimationSpeed = 30
    $progressBar.Visible = $true
    
    # Highlight terminal panel to show running
    $terminalLabel.Text = "⚡ Terminal Output - RUNNING"
    $terminalLabel.ForeColor = [System.Drawing.Color]::FromArgb(0, 200, 100)
    $terminalPanel.BackColor = [System.Drawing.Color]::FromArgb(20, 40, 20)
    
    # Start the script timer with spinner animation
    $script:scriptTimer = New-Object System.Windows.Forms.Timer
    $script:scriptTimer.Interval = 100  # Update every 100ms for smooth spinner
    $script:scriptTimer.Add_Tick({
        $elapsed = (Get-Date) - $script:scriptStartTime
        $spinner = $spinnerChars[$script:spinnerIndex % $spinnerChars.Count]
        $seconds = [Math]::Floor($elapsed.TotalSeconds)
        $statusLabel.Text = "$spinner Running: $script:currentRunningScript ($($seconds)s)"
        $statusLabel.ForeColor = [System.Drawing.Color]::FromArgb(0, 200, 100)
        $script:spinnerIndex++
    })
    $script:scriptTimer.Start()
}

function Stop-ScriptExecution {
    # Kill the running process if it exists
    if ($script:runningProcess -and -not $script:runningProcess.HasExited) {
        try {
            $script:runningProcess.Kill()
            Write-TerminalOutput "Script execution stopped by user" ([System.Drawing.Color]::FromArgb(255, 200, 0))
        } catch {
            Write-TerminalOutput "Error stopping script: $($_.Exception.Message)" ([System.Drawing.Color]::FromArgb(220, 50, 50))
        }
    }
    
    if ($script:scriptTimer) {
        $script:scriptTimer.Stop()
        $script:scriptTimer.Dispose()
        $script:scriptTimer = $null
    }
    
    # Hide progress bar
    $progressBar.Visible = $false
    $progressBar.Style = [System.Windows.Forms.ProgressBarStyle]::Continuous
    
    # Restore terminal panel appearance
    $terminalLabel.Text = "Terminal Output"
    $colors = if ($script:darkModeEnabled) { $darkMode } else { $lightMode }
    $terminalLabel.ForeColor = $colors.ForeColor
    $terminalPanel.BackColor = $colors.BackColor
    
    # Update UI
    $script:stopButton.Enabled = $false
    $script:runButton.Enabled = ($scriptsListView.SelectedItems.Count -gt 0)
    $script:runAsAdminButton.Enabled = ($scriptsListView.SelectedItems.Count -gt 0)
    $script:isScriptRunning = $false
    $script:runningProcess = $null
    
    # Update status to show completion time
    if ($scriptStartTime -and $currentRunningScript) {
        $elapsed = (Get-Date) - $scriptStartTime
        $elapsedStr = "$([Math]::Floor($elapsed.TotalSeconds))s"
        
        $statusLabel.Text = "[DONE] Completed: $currentRunningScript ($elapsedStr)"
        $statusLabel.ForeColor = [System.Drawing.Color]::FromArgb(0, 150, 255)
    } else {
        $statusLabel.Text = "Ready"
        $statusLabel.ForeColor = [System.Drawing.Color]::FromArgb(0, 123, 255)
    }
    
    $currentRunningScript = ""
    $scriptStartTime = $null
}

function Run-Script {
    param($scriptPath, $asAdmin = $false, $parameters = "", $showNotification = $false)
    
    if (-not (Test-Path $scriptPath)) {
        Write-TerminalOutput "Error: Script file does not exist"
        return
    }
    
    $scriptName = [System.IO.Path]::GetFileName($scriptPath)
    Start-ScriptExecution -scriptName $scriptName
    
    $paramDisplay = if ($parameters) { " with params: $parameters" } else { "" }
    Write-TerminalOutput "Starting script: $scriptPath $(if ($asAdmin) { '(as Administrator)' } else { '(normal user)' })$paramDisplay"
    
    try {
        if ($asAdmin) {
            # Run as administrator - with UAC prompt
            Write-TerminalOutput "Requesting administrator elevation..."
            
            $psArgs = if ($parameters) { "-File `"$scriptPath`" $parameters" } else { "-File `"$scriptPath`"" }
            $process = Start-Process -FilePath "powershell.exe" -ArgumentList $psArgs -Verb RunAs -PassThru -Wait
            
            # Store process reference for stopping
            $script:runningProcess = $process
            
            Write-TerminalOutput "Admin script completed with exit code: $($process.ExitCode)"
            
            # Log execution
            $duration = if ($script:scriptStartTime) { [Math]::Floor(((Get-Date) - $script:scriptStartTime).TotalSeconds) } else { 0 }
            $status = if ($process.ExitCode -eq 0) { "Success" } else { "Failed" }
            Add-ExecutionLogEntry -scriptName $scriptName -scriptPath $scriptPath -status $status -exitCode $process.ExitCode -durationSeconds $duration -showNotification $showNotification
        } else {
            # Run as current user - capture output directly
            $tempOut = [System.IO.Path]::GetTempFileName()
            $tempErr = [System.IO.Path]::GetTempFileName()
            
            $psArgs = if ($parameters) { "-File `"$scriptPath`" $parameters" } else { "-File `"$scriptPath`"" }
            $process = Start-Process -FilePath "powershell.exe" -ArgumentList $psArgs -NoNewWindow -PassThru -RedirectStandardOutput $tempOut -RedirectStandardError $tempErr
            
            # Store process reference for stopping
            $script:runningProcess = $process
            
            # Wait for process to complete
            $process.WaitForExit()
            
            # Read and display output
            if (Test-Path $tempOut) {
                $output = Get-Content $tempOut -Raw
                if ($output) {
                    Write-TerminalOutput "Output:`n$output"
                }
                Remove-Item $tempOut -Force
            }
            
            if (Test-Path $tempErr) {
                $errorOutput = Get-Content $tempErr -Raw
                if ($errorOutput) {
                    Write-TerminalOutput "Errors:`n$errorOutput"
                }
                Remove-Item $tempErr -Force
            }
            
            # Log execution
            $duration = if ($script:scriptStartTime) { [Math]::Floor(((Get-Date) - $script:scriptStartTime).TotalSeconds) } else { 0 }
            $status = if ($process.ExitCode -eq 0) { "Success" } else { "Failed" }
            Add-ExecutionLogEntry -scriptName $scriptName -scriptPath $scriptPath -status $status -exitCode $process.ExitCode -durationSeconds $duration -showNotification $showNotification
        }
        
        Write-TerminalOutput "Script completed with exit code: $($process.ExitCode)"
        Stop-ScriptExecution
    }
    catch {
        Write-TerminalOutput "Error running script: $($_.Exception.Message)"
        
        # Log failed execution
        $duration = if ($script:scriptStartTime) { [Math]::Floor(((Get-Date) - $script:scriptStartTime).TotalSeconds) } else { 0 }
        Add-ExecutionLogEntry -scriptName $scriptName -scriptPath $scriptPath -status "Failed" -exitCode -1 -durationSeconds $duration -showNotification $showNotification
        
        Stop-ScriptExecution
    }
}

