# Syntax Highlighting Function for PowerShell Code
function Apply-SyntaxHighlighting {
    param([System.Windows.Forms.RichTextBox]$textBox)
    
    # Store current cursor position
    $cursorPos = $textBox.SelectionStart
    
    # Suspend drawing for performance
    $textBox.SuspendLayout()
    
    # Colors optimized for dark background (code viewer is always dark)
    $defaultColor = [System.Drawing.Color]::FromArgb(212, 212, 212)     # Light gray - default text
    $keywordColor = [System.Drawing.Color]::FromArgb(86, 156, 214)      # Blue - keywords
    $cmdletColor = [System.Drawing.Color]::FromArgb(220, 220, 170)      # Yellow - cmdlets
    $stringColor = [System.Drawing.Color]::FromArgb(206, 145, 120)      # Orange/Brown - strings
    $commentColor = [System.Drawing.Color]::FromArgb(106, 153, 85)      # Green - comments
    $variableColor = [System.Drawing.Color]::FromArgb(156, 220, 254)    # Light blue - variables
    $operatorColor = [System.Drawing.Color]::FromArgb(180, 180, 180)    # Gray - operators
    $typeColor = [System.Drawing.Color]::FromArgb(78, 201, 176)         # Teal - types
    $numberColor = [System.Drawing.Color]::FromArgb(181, 206, 168)      # Light green - numbers
    
    # Set default color first
    $textBox.SelectAll()
    $textBox.SelectionColor = $defaultColor
    
    $text = $textBox.Text
    
    # PowerShell keywords
    $keywords = @(
        'function', 'param', 'begin', 'process', 'end', 'if', 'else', 'elseif', 
        'switch', 'while', 'for', 'foreach', 'do', 'until', 'break', 'continue',
        'return', 'exit', 'throw', 'try', 'catch', 'finally', 'trap', 'filter',
        'in', 'class', 'enum', 'using', 'workflow', 'parallel', 'sequence',
        'inlinescript', 'configuration', 'data', 'dynamicparam', 'hidden', 'static'
    )
    
    # Highlight keywords (word boundaries)
    foreach ($keyword in $keywords) {
        $pattern = "(?i)\b$keyword\b"
        $matches = [regex]::Matches($text, $pattern)
        foreach ($match in $matches) {
            $textBox.Select($match.Index, $match.Length)
            $textBox.SelectionColor = $keywordColor
        }
    }
    
    # Highlight variables ($variableName, $env:, $script:, $global:, etc.)
    $varPattern = '\$[\w:]+|\$\{[^}]+\}'
    $varMatches = [regex]::Matches($text, $varPattern)
    foreach ($match in $varMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $variableColor
    }
    
    # Highlight cmdlets (Verb-Noun pattern)
    $cmdletPattern = '\b(Get|Set|New|Remove|Add|Clear|Write|Read|Out|Start|Stop|Invoke|Test|Enable|Disable|Export|Import|ConvertTo|ConvertFrom|Format|Select|Where|Sort|Group|Measure|Compare|Copy|Move|Rename|Split|Join|Update|Register|Unregister|Wait|Show|Hide|Enter|Exit|Push|Pop|Receive|Send|Suspend|Resume|Restart|Reset|Undo|Redo|Save|Open|Close|Connect|Disconnect|Publish|Unpublish|Install|Uninstall|Find|Search|Resolve|Expand|Compress|Merge|Debug|Trace|Assert|Confirm|Deny|Grant|Revoke|Protect|Unprotect|Lock|Unlock|Watch|Use|Block|Unblock|Limit|Optimize|Initialize|Mount|Dismount|Backup|Restore|Sync|Repair|Complete|Submit|Request|Approve|Checkpoint)-\w+'
    $cmdletMatches = [regex]::Matches($text, $cmdletPattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
    foreach ($match in $cmdletMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $cmdletColor
    }
    
    # Highlight types [typename]
    $typePattern = '\[[^\]]+\]'
    $typeMatches = [regex]::Matches($text, $typePattern)
    foreach ($match in $typeMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $typeColor
    }
    
    # Highlight numbers
    $numberPattern = '\b\d+\.?\d*\b'
    $numberMatches = [regex]::Matches($text, $numberPattern)
    foreach ($match in $numberMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $numberColor
    }
    
    # Highlight strings (double-quoted) - be careful with escaped quotes
    $doubleStringPattern = '"(?:[^"\\]|\\.)*"'
    $doubleStringMatches = [regex]::Matches($text, $doubleStringPattern, [System.Text.RegularExpressions.RegexOptions]::Singleline)
    foreach ($match in $doubleStringMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $stringColor
    }
    
    # Highlight strings (single-quoted)
    $singleStringPattern = "'(?:[^'\\]|\\.)*'"
    $singleStringMatches = [regex]::Matches($text, $singleStringPattern, [System.Text.RegularExpressions.RegexOptions]::Singleline)
    foreach ($match in $singleStringMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $stringColor
    }
    
    # Highlight here-strings @" "@ and @' '@
    $hereStringPattern = '@["''][\s\S]*?["'']@'
    $hereStringMatches = [regex]::Matches($text, $hereStringPattern)
    foreach ($match in $hereStringMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $stringColor
    }
    
    # Highlight single-line comments (# ...) - do this last to override strings in comments
    $commentPattern = '#(?!\>).*$'
    $commentMatches = [regex]::Matches($text, $commentPattern, [System.Text.RegularExpressions.RegexOptions]::Multiline)
    foreach ($match in $commentMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $commentColor
    }
    
    # Highlight block comments <# ... #>
    $blockCommentPattern = '<#[\s\S]*?#>'
    $blockCommentMatches = [regex]::Matches($text, $blockCommentPattern)
    foreach ($match in $blockCommentMatches) {
        $textBox.Select($match.Index, $match.Length)
        $textBox.SelectionColor = $commentColor
    }
    
    # Restore cursor position
    $textBox.Select($cursorPos, 0)
    $textBox.ResumeLayout()
}

function Update-ScriptsList {
    param($folderPath)
    
    $scriptsListView.Items.Clear()
    $global:allScripts = @()
    
    if (-not (Test-Path $folderPath)) {
        Write-TerminalOutput "Error: Folder does not exist"
        return
    }
    
    try {
        $isRecursive = $recursiveCheckBox.Checked
        if ($isRecursive) {
            $ps1Files = Get-ChildItem -Path $folderPath -Filter "*.ps1" -File -Recurse -ErrorAction SilentlyContinue
        } else {
            $ps1Files = Get-ChildItem -Path $folderPath -Filter "*.ps1" -File -ErrorAction SilentlyContinue
        }
        
        # Load favorites for star display
        $script:favorites = Load-Favorites
        
        # Sort: favorites first, then alphabetically
        $sortedFiles = $ps1Files | Sort-Object { 
            $isFav = if ($script:favorites -contains $_.FullName) { 0 } else { 1 }
            $isFav, $_.Name
        }
        
        foreach ($file in $sortedFiles) {
            # Show relative path for recursive, just name for non-recursive
            $displayName = if ($isRecursive) {
                $relativePath = $file.FullName.Substring($folderPath.Length).TrimStart(@('\', '/'))
                $relativePath
            } else {
                $file.Name
            }
            
            $scriptInfo = @{
                Name = $displayName
                Size = [math]::Round($file.Length / 1KB, 2)
                FullName = $file.FullName
            }
            $global:allScripts += $scriptInfo
            
            # Check if favorite
            $starText = if ($script:favorites -contains $file.FullName) { "★" } else { "" }
            
            $item = New-Object System.Windows.Forms.ListViewItem($starText)
            $item.SubItems.Add($displayName) | Out-Null
            $item.SubItems.Add($scriptInfo.Size) | Out-Null
            $item.Tag = $file.FullName
            
            # Highlight favorites with color
            if ($script:favorites -contains $file.FullName) {
                $item.ForeColor = [System.Drawing.Color]::FromArgb(255, 193, 7)
            }
            
            $scriptsListView.Items.Add($item) | Out-Null
        }
        
        $scanType = if ($isRecursive) { "recursively" } else { "" }
        Write-TerminalOutput "Found $($ps1Files.Count) PowerShell scripts $scanType in $folderPath"
        $statusLabel.Text = "Loaded $($ps1Files.Count) scripts"
    }
    catch {
        Write-TerminalOutput "Error scanning folder: $($_.Exception.Message)"
    }
}

function Filter-ScriptsList {
    param($searchText)
    
    $scriptsListView.Items.Clear()
    
    if ([string]::IsNullOrWhiteSpace($searchText)) {
        # If search is empty, show all items
        $script:favorites = Load-Favorites
        foreach ($script in $global:allScripts) {
            $starText = if ($script:favorites -contains $script.FullName) { "★" } else { "" }
            $item = New-Object System.Windows.Forms.ListViewItem($starText)
            $item.SubItems.Add($script.Name) | Out-Null
            $item.SubItems.Add($script.Size) | Out-Null
            $item.Tag = $script.FullName
            if ($script:favorites -contains $script.FullName) {
                $item.ForeColor = [System.Drawing.Color]::FromArgb(255, 193, 7)
            }
            $scriptsListView.Items.Add($item) | Out-Null
        }
        $statusLabel.Text = "Showing all $($global:allScripts.Count) scripts"
        return
    }
    
    $script:favorites = Load-Favorites
    $filteredScripts = $global:allScripts | Where-Object { $_.Name -like "*$searchText*" }
    foreach ($script in $filteredScripts) {
        $starText = if ($script:favorites -contains $script.FullName) { "★" } else { "" }
        $item = New-Object System.Windows.Forms.ListViewItem($starText)
        $item.SubItems.Add($script.Name) | Out-Null
        $item.SubItems.Add($script.Size) | Out-Null
        $item.Tag = $script.FullName
        if ($script:favorites -contains $script.FullName) {
            $item.ForeColor = [System.Drawing.Color]::FromArgb(255, 193, 7)
        }
        $scriptsListView.Items.Add($item) | Out-Null
    }
    
    $statusLabel.Text = "Found $($filteredScripts.Count) scripts matching '$searchText'"
}

function Get-SortedScripts {
    param($scripts)
    
    $isDesc = $script:sortDirection -eq "Desc"
    $favorites = Load-Favorites
    
    switch ($script:sortColumn) {
        "Size" {
            return $scripts | Sort-Object 
                @{ Expression = { if ($favorites -contains $_.FullName) { 0 } else { 1 } } },
                @{ Expression = { $_.Size }; Descending = $isDesc },
                @{ Expression = { $_.Name } }
        }
        "Star" {
            return $scripts | Sort-Object 
                @{ Expression = { if ($favorites -contains $_.FullName) { 0 } else { 1 } }; Descending = $isDesc },
                @{ Expression = { $_.Name } }
        }
        default { # Name
            return $scripts | Sort-Object 
                @{ Expression = { if ($favorites -contains $_.FullName) { 0 } else { 1 } } },
                @{ Expression = { $_.Name }; Descending = $isDesc }
        }
    }
}

function Render-ScriptsList {
    param($scripts)
    
    $scriptsListView.BeginUpdate()
    $scriptsListView.Items.Clear()
    $favorites = Load-Favorites
    $sortedScripts = Get-SortedScripts -scripts $scripts
    foreach ($script in $sortedScripts) {
        $starText = if ($favorites -contains $script.FullName) { "★" } else { "" }
        $item = New-Object System.Windows.Forms.ListViewItem($starText)
        $item.SubItems.Add($script.Name) | Out-Null
        $item.SubItems.Add($script.Size) | Out-Null
        $item.Tag = $script.FullName
        if ($favorites -contains $script.FullName) {
            $item.ForeColor = [System.Drawing.Color]::FromArgb(255, 193, 7)
        }
        $scriptsListView.Items.Add($item) | Out-Null
    }
    $scriptsListView.EndUpdate()
}

