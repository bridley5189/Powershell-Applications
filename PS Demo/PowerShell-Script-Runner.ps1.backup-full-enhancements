function Add-ToScriptHistory {
    param($scriptName, $scriptPath)
    
    # Create history entry
    $entry = @{
        Name = $scriptName
        Path = $scriptPath
        Timestamp = Get-Date -Format "HH:mm:ss"
        Date = Get-Date -Format "MM/dd/yyyy"
    }
    
    # Add to history (keep only last 15 entries)
    $script:scriptHistory = @($entry) + $script:scriptHistory | Select-Object -First 15
    
    # Update the history listbox
    Update-HistoryListBox
}

function Update-HistoryListBox {
    $historyListBox.Items.Clear()
    
    if ($script:scriptHistory.Count -eq 0) {
        $historyListBox.Items.Add("No recent scripts")
        return
    }
    
    foreach ($entry in $script:scriptHistory) {
        $displayText = "$($entry.Name) - $($entry.Timestamp)"
        $historyListBox.Items.Add($displayText)
    }
}

function Get-HistoryItemPath {
    param($index)
    
    if ($index -ge 0 -and $index -lt $script:scriptHistory.Count) {
        return $script:scriptHistory[$index].Path
    }
    return $null
}
